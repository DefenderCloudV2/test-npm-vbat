{
  "name": "@defendercloudv2/test-npm-vbat",
  "version": "1.0.0",
  "description": "Console sample for comparing npm registry metadata, provenance, and SBOMs.",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "bin": {
    "test-npm-vbat": "./src/cli.js"
  },
  "files": [
    "src/",
    "build-info.json",
    "sbom.cdx.json",
    "sbom.spdx.json"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DefenderCloudV2/test-npm-vbat.git"
  },
  "homepage": "https://github.com/DefenderCloudV2/test-npm-vbat#readme",
  "bugs": {
    "url": "https://github.com/DefenderCloudV2/test-npm-vbat/issues"
  },
  "license": "MIT",
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test",
    "sbom": "node scripts/generate-sboms.mjs",
    "prepare:package": "node scripts/build-metadata.mjs && npm run sbom",
    "prepack": "npm run prepare:package",
    "inspect:registry": "node scripts/inspect-registry.mjs"
  },
  "dependencies": {
    "axios": "1.20.0",
    "chalk": "6.0.1",
    "lodash-es": "4.18.1",
    "semver": "7.8.5"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
